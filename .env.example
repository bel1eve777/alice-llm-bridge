# .env.example — скопируйте в .env и заполните
# cp .env.example .env

# ──────────────────────────────────────────────
# ОБЯЗАТЕЛЬНЫЕ: LLM настройки
# ──────────────────────────────────────────────

# OpenRouter (рекомендуется — бесплатные модели)
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=sk-or-v1-ваш_ключ_сюда
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Альтернативы (разкомментируйте нужное):

# Groq (очень быстро, бесплатно)
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_API_KEY=gsk_ваш_ключ
# LLM_MODEL=llama-3.1-70b-versatile

# Together AI
# LLM_API_URL=https://api.together.xyz/v1/chat/completions
# LLM_API_KEY=ваш_ключ
# LLM_MODEL=meta-llama/Llama-3.1-70B-Instruct-Turbo

# ──────────────────────────────────────────────
# ОПЦИОНАЛЬНЫЕ: тонкая настройка
# ──────────────────────────────────────────────

# Системный промпт (поведение ИИ)
# SYSTEM_PROMPT=Ты — полезный голосовой ассистент. Отвечай кратко, по-русски, в разговорном стиле. Без markdown. Максимум 2 предложения.

# Лимиты генерации
# MAX_TOKENS=300
# TEMPERATURE=0.7

# Таймаут запроса к LLM (сек)
# REQUEST_TIMEOUT=30